NODE_ENV=development
PORT=4000
# Uno o varios orígenes separados por coma. No agregues una barra al final.
FRONTEND_URLS=http://localhost:5173

# Google Sheets: comparte la hoja con GOOGLE_SERVICE_ACCOUNT_EMAIL.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase Admin para verificar los tokens emitidos al frontend.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Política de acceso. Separa varios valores con coma.
ALLOWED_EMAIL_DOMAIN=iglesia.com
AUTHORIZED_PERSONAL_EMAILS=
ADMIN_EMAILS=
HOSTESS_EMAILS=
REGISTRO_EMAILS=

# Cloudinary: la clave secreta se configura únicamente en el backend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend utiliza HTTPS, por lo que funciona en Render Free.
RESEND_API_KEY=
RESEND_FROM="Asistencia Iglesia <reportes@tu-dominio.org>"
CHURCH_NAME=Nombre de la Iglesia

# Modo demo evita llamadas a Google. Nunca usar en producción.
DEMO_MODE=true
